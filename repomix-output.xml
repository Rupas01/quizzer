<file path="backend/controllers/quizController.js">
const crypto = require("crypto");
const bcrypt = require("bcrypt");
const { createQuiz, searchQuiz, getQuizById } = require("../models/Quiz");
const { isUserJoined, addParticipant } = require("../models/Participant");

const createNewQuiz = async (req, res) => {
    const creator_id = req.user.id;
    const { name, description, is_private, password } = req.body;

    try {
        const quizId = "QZ" + crypto.randomBytes(3).toString("hex").toUpperCase();
        const hashedPass = is_private ? await bcrypt.hash(password, 10) : null;

        await createQuiz({ quizId, creator_id, name, description, is_private, password: hashedPass });
        res.status(201).json({ message: "Quiz created", quiz_id: quizId });
    } catch (err) {
        res.status(500).json({ message: "Quiz creation failed" });
    }
};

const searchExistingQuiz = async (req, res) => {
    const q = req.query.query;
    if (!q) return res.status(400).json({ error: "Query required" });

    try {
        const results = await searchQuiz(q);
        res.json(results);
    } catch (err) {
        res.status(500).json({ message: "Search failed" });
    }
};

const joinQuiz = async (req, res) => {
    const userId = req.user.id;
    const { quizId, password } = req.body;

    try {
        const quiz = await getQuizById(quizId);
        if (!quiz) return res.status(404).json({ message: "Quiz not found" });

        if (await isUserJoined(quizId, userId))
            return res.status(409).json({ message: "Already joined" });

        if (quiz.is_private) {
            const ok = await bcrypt.compare(password, quiz.password);
            if (!ok) return res.status(401).json({ message: "Wrong password" });
        }

        await addParticipant(quizId, userId);
        res.json({ message: "Joined quiz" });
    } catch (err) {
        res.status(500).json({ message: "Join quiz error" });
    }
};

module.exports = { createNewQuiz, searchExistingQuiz, joinQuiz };
</file>

