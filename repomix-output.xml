                return res.status(500).json({ message: "Database error." });
            }
            res.status(201).json({ message: "User registered successfully." });
        });
    } catch (error) {
        res.status(500).json({ message: "Server error." });
    }
});

// ✅ Login route
app.post("/login", (req, res) => {
    const { username, password } = req.body;

    if (!username || !password)
        return res.status(400).json({ message: "Please fill in all fields." });

    const query = "SELECT * FROM users WHERE username = ?";
    db.query(query, [username], async (err, results) => {
        if (err) return res.status(500).json({ message: "Database error." });
        if (results.length === 0)
            return res.status(401).json({ message: "Invalid credentials." });

        const user = results[0];
        const match = await bcrypt.compare(password, user.password);

        if (!match)
            return res.status(401).json({ message: "Invalid credentials." });

        // ✅ Send success response
        res.status(200).json({
            message: "Login successful.",
            user: {
                id: user.id,
                username: user.username,
                role: user.role
            }
        });
    });
});

app.post("/createQuiz", async (req, res) => {
    const { creator_id, name, description, is_private, password } = req.body;

    if (!creator_id || !name)
        return res.status(400).json({ message: "Quiz name and creator required." });

    const quizId = "QZ" + crypto.randomBytes(3).toString("hex").toUpperCase();
    const hashedPass = is_private && password
        ? await bcrypt.hash(password, 10)
        : null;

    const query = `
    INSERT INTO quizzes (quiz_id, creator_id, name, description, is_private, password)
    VALUES (?, ?, ?, ?, ?, ?)
  `;
    db.query(query, [quizId, creator_id, name, description, is_private, hashedPass], (err) => {
        if (err) {
            console.error(err);
            return res.status(500).json({ message: "Database error." });
        }
        res.status(201).json({ message: "Quiz created successfully.", quiz_id: quizId });
    });
});

// Search quizzes by name or ID
app.get("/api/searchQuiz", async (req, res) => {
  const query = req.query.query;
  try {
    const [rows] = await db.execute(
      "SELECT * FROM quizzes WHERE quiz_id = ? OR title LIKE ?",
      [query, `%${query}%`]
    );
    res.json(rows);
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Server error while searching quizzes" });
  }
});

// Join quiz
app.post("/api/joinQuiz", async (req, res) => {
  const { quizId, password, userId } = req.body;
  try {
    const [quizData] = await db.execute("SELECT * FROM quizzes WHERE quiz_id = ?", [quizId]);
    if (quizData.length === 0) return res.json({ success: false, message: "Quiz not found" });

    const quiz = quizData[0];
    if (quiz.is_private && quiz.password !== password)
      return res.json({ success: false, message: "Incorrect password" });

    // Store user participation (optional)
    await db.execute("INSERT INTO participants (quiz_id, user_id) VALUES (?, ?)", [quizId, userId]);

    res.json({ success: true });
  } catch (error) {
    console.error(error);
    res.status(500).json({ success: false, message: "Error joining quiz" });
  }
});


// ✅ Start server
const PORT = 5000;
app.listen(PORT, () => console.log(`🚀 Server running on http://localhost:${PORT}`));
</file>

